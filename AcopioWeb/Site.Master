<%@ Master Language="VB"
    AutoEventWireup="false"
    CodeBehind="Site.Master.vb"
    Inherits="AcopioWeb.SiteMaster" %>

<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>APAS - AcopioWeb</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet" />

    <asp:ContentPlaceHolder
        ID="HeadContent"
        runat="server" />
</head>
<body class="bg-light">
    <form id="form1" runat="server">

        <nav class="navbar navbar-dark bg-success">
            <div class="container d-flex gap-3 flex-wrap">

                <a class="navbar-brand"
                   href="<%= ResolveUrl("~/Default.aspx") %>">
                    APAS | AcopioWeb
                </a>

                <div class="d-flex gap-3 align-items-center flex-wrap">

                    <asp:HyperLink
                        ID="lnkRegistrar"
                        runat="server"
                        NavigateUrl="~/RegistrarEntrega.aspx"
                        CssClass="text-white"
                        Text="Registrar entrega" />

                    <asp:HyperLink
                        ID="lnkConsultar"
                        runat="server"
                        NavigateUrl="~/ConsultarEntregas.aspx"
                        CssClass="text-white"
                        Text="Consultar entregas" />

                    <asp:HyperLink
                        ID="lnkIngresar"
                        runat="server"
                        NavigateUrl="~/Ingresar.aspx"
                        CssClass="text-white"
                        Text="Ingresar" />

                    <asp:LinkButton
                        ID="btnSalir"
                        runat="server"
                        CssClass="btn btn-outline-light btn-sm"
                        CausesValidation="false"
                        OnClick="btnSalir_Click">
                        Cerrar sesión
                    </asp:LinkButton>

                </div>
            </div>
        </nav>

        <main class="container py-4">
            <asp:ContentPlaceHolder
                ID="MainContent"
                runat="server" />
        </main>

    </form>
</body>
</html>
